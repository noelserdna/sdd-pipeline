{
  "description": "SDD pipeline guardrails: pipeline status injection at session start, upstream immutability guard, fabricated AI-consent guard on Bash, traceability context on file access, and pipeline-state updates (a stage is marked running when its skill starts or when a file under its directory is written); asks before recording acceptance (sdd accept record, fase-N-accepted and requirements-vN tags).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/sdd-session-start.sh\"", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/sdd-upstream-guard.sh\"", "timeout": 5 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/sdd-tool-guard.sh\"", "timeout": 5 }
        ]
      },
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/sdd-augment-hook.js\"", "timeout": 5 }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/sdd-pipeline-state-updater.sh\"", "timeout": 5, "async": true }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/sdd-pipeline-state-updater.sh\"", "timeout": 10, "async": true }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/sdd-pipeline-state-updater.sh\"", "timeout": 5, "async": true }
        ]
      }
    ]
  }
}
